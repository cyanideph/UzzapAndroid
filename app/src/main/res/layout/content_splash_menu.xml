<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/uzzapColorBg">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/d_logo_large"
        android:scaleType="fitCenter"
        android:contentDescription="@string/uzzap_beta"/>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"/>

    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"/>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2.2"/>
</LinearLayout>
