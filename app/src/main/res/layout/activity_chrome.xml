<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chrome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/legacy_background"
    android:fitsSystemWindows="false">

    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/legacy_background" />

    <include layout="@layout/view_titlebar" />

    <LinearLayout
        android:id="@+id/tab_strip_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/legacy_functionbar_middle"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/legacy_background" />

    <include layout="@layout/view_softkeybar" />

    <View
        android:id="@+id/nav_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/legacy_functionbar_middle" />
</LinearLayout>
