<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/uzzapColorBg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/iv_welcome_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/d_logo_large" />

        <TextView
            android:id="@+id/tv_welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Welcome to Uzzap"
            android:textColor="?attr/uzzapColorAccent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_welcome_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="A quick guide to chats, buddies, and rooms."
            android:textColor="?attr/uzzapColorText"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_welcome_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_welcome_card"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:text="@string/welcome_intro"
            android:textColor="?attr/uzzapColorText"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="What you can do"
            android:textColor="?attr/uzzapColorAccent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/tip_im"
            layout="@layout/item_welcome_tip" />

        <include
            android:id="@+id/tip_add"
            layout="@layout/item_welcome_tip" />

        <include
            android:id="@+id/tip_chat"
            layout="@layout/item_welcome_tip" />

        <include
            android:id="@+id/tip_matching"
            layout="@layout/item_welcome_tip" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_welcome_card"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:text="Need more detail? Open Help from the Uzzap menu."
            android:textColor="?attr/uzzapColorText"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
