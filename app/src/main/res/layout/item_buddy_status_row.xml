<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_menu_row_selector"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="38dp" android:layout_height="38dp">
        <ImageView android:id="@+id/iv_buddy_avatar" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:scaleType="centerCrop" android:contentDescription="@null"/>
        <ImageView android:id="@+id/iv_status_icon" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|end" android:src="@drawable/d_offline" android:contentDescription="@null"/>
    </FrameLayout>
    <TextView android:id="@+id/tv_status_username" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:textSize="14sp" android:textColor="?attr/uzzapColorText" android:text="unknown-user"/>
    <TextView android:id="@+id/tv_unread_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="22dp" android:gravity="center" android:textStyle="bold" android:textSize="12sp" android:textColor="?attr/uzzapColorText" android:background="@drawable/bg_unread_badge" android:visibility="gone" />
</LinearLayout>
