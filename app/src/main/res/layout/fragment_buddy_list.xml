<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/uzzap_clay_bg" android:paddingStart="14dp" android:paddingEnd="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="10dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buddies" android:textColor="@color/uzzap_clay_header" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="See who's around and start a private chat" android:textColor="@color/uzzap_clay_muted" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_clay_card" android:minHeight="72dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:elevation="3dp">
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_clay_primary" android:padding="10dp"><ImageView android:id="@+id/iv_my_status" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/d_online" android:contentDescription="@null"/></FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/tv_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/uzzap_clay_text" android:text="unknown-user"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Online status" android:textSize="12sp" android:textColor="@color/uzzap_clay_muted"/>
        </LinearLayout>
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_online_dot"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_clay_input" android:gravity="center_vertical" android:paddingStart="14dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_clay_search" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Search buddies" android:textColor="@color/uzzap_clay_muted" android:textSize="14sp"/>
    </LinearLayout>
    <ListView android:id="@+id/list_groups" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:clipToPadding="false" android:paddingBottom="14dp"/>
</LinearLayout>