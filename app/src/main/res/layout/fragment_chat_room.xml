<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/legacy_background">

    <TextView
        android:id="@+id/tv_room_caption"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="@color/uzzap_white"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/uzzap_text"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/room_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/legacy_background"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="never" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/uzzap_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/uzzap_white">

        <TextView
            android:id="@+id/tv_to_room"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/uzzap_special_blue"
            android:textSize="12sp"
            android:text="To: Main Lobby" />

        <ImageView
            android:id="@+id/iv_emoticon_picker"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/d_emoticon_wink"
            android:padding="2dp"
            android:contentDescription="Add Emoticon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/uzzap_white">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_editor"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical"
            android:textSize="12sp"
            android:textColor="@color/uzzap_text"
            android:textColorHint="@color/uzzap_text"
            android:hint="Message"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:background="@drawable/bg_menu_row_selector"
            android:textColor="@color/uzzap_text"
            android:textSize="12sp"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
