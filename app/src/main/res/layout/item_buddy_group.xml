<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/legacy_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_row_selector"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <ImageView
            android:id="@+id/iv_group_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"/>
        <TextView
            android:id="@+id/tv_group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:textColor="@color/uzzap_text"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/uzzap_editor_bg"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:visibility="gone">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/d_search" android:contentDescription="@null"/>
        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@null"
            android:hint="Search buddies"
            android:textSize="13sp"
            android:includeFontPadding="false"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/container_buddies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingStart="28dp"
        android:gravity="center_vertical"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:textColor="@color/uzzap_scroll_fill"
        android:text="No buddies yet."
        android:visibility="gone"/>
</LinearLayout>
