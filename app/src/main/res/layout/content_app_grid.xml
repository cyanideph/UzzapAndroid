<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/uzzapColorBg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uzzap" android:textSize="28sp" android:textStyle="bold" android:textColor="?attr/uzzapColorText" android:paddingBottom="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect, chat and discover your rooms" android:textSize="14sp" android:textColor="?attr/uzzapColorMuted" android:paddingBottom="18dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<ImageButton android:id="@+id/icon_u" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_chat" android:contentDescription="Uzzap"/>
<ImageButton android:id="@+id/icon_matching" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_buddies" android:contentDescription="Buddies"/>
<ImageButton android:id="@+id/icon_addbuddy" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_profile" android:contentDescription="Profile"/>
<ImageButton android:id="@+id/icon_settings" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_settings" android:contentDescription="Settings"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
<ImageButton android:id="@+id/icon_themes" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_rooms" android:contentDescription="Rooms"/>
<ImageButton android:id="@+id/icon_help" style="@style/GridIcon" android:layout_weight="1" android:src="@drawable/ic_uzzap_search" android:contentDescription="Search"/>
</LinearLayout>
<TextView android:id="@+id/tv_footer_feature_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@color/uzzap_green" android:gravity="center" android:padding="12dp" android:textColor="@color/uzzap_white" android:textSize="15sp" android:textStyle="bold" android:text="@string/extended_messaging"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="12dp" android:background="?attr/uzzapColorSurface">
<ImageButton android:id="@+id/icon_em" style="@style/GridIconSmall" android:src="@drawable/ic_uzzap_buddies" android:contentDescription="Extended Messaging"/>
<ImageButton android:id="@+id/icon_im" style="@style/GridIconSmall" android:src="@drawable/ic_uzzap_chat" android:contentDescription="Instant Messaging"/>
<ImageButton android:id="@+id/icon_chat" style="@style/GridIconSmall" android:src="@drawable/ic_uzzap_rooms" android:contentDescription="Chat Rooms"/>
<ImageButton android:id="@+id/icon_profile" style="@style/GridIconSmall" android:src="@drawable/ic_uzzap_profile" android:contentDescription="Profile"/>
</LinearLayout>
</LinearLayout></ScrollView>