<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/softkey_bar_root"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:clipChildren="true">
    <LinearLayout android:id="@+id/legacy_functionbar_art" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <ImageView android:layout_width="16dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/d_functionbar_left" android:contentDescription="@null" />
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/legacy_functionbar_middle" android:contentDescription="@null" />
        <ImageView android:layout_width="16dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/d_functionbar_right" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <TextView android:id="@+id/btn_left" style="@style/UzzapSoftkeyText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:paddingStart="4dp" android:text="@string/softkey_options" />
        <TextView android:id="@+id/btn_right" style="@style/UzzapSoftkeyText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="end|center_vertical" android:paddingEnd="4dp" android:text="@string/softkey_exit" />
    </LinearLayout>
</FrameLayout>
