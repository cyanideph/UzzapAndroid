<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/softkey_bar_root"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bar_bottom"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="10dp">
    <TextView android:id="@+id/btn_left" style="@style/UzzapSoftkeyText" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_clay_nav_selector" android:drawableStart="@drawable/ic_clay_menu" android:drawablePadding="8dp" android:text="@string/softkey_options"/>
    <TextView android:id="@+id/btn_right" style="@style/UzzapSoftkeyText" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="10dp" android:gravity="center" android:background="@drawable/bg_clay_nav_selector" android:drawableStart="@drawable/ic_clay_arrow" android:drawablePadding="8dp" android:text="@string/softkey_exit"/>
</LinearLayout>