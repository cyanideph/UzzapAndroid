<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bar_titlebar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp"
    android:elevation="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_clay_u" android:contentDescription="@string/app_name" android:padding="6dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/tv_title" style="@style/UzzapTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect • Chat • Belong" android:textColor="#DCE0FF" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/iv_status_ball" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/d_online" android:visibility="gone" android:contentDescription="@null" android:padding="5dp"/>
</LinearLayout>