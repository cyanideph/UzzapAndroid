<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar_root"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:clipChildren="true">
    <LinearLayout
        android:id="@+id/legacy_titlebar_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView android:layout_width="16dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/d_titlebar_left" android:contentDescription="@null" />
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/legacy_titlebar_middle" android:contentDescription="@null" />
        <ImageView android:layout_width="16dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/d_titlebar_right" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/tv_title" style="@style/UzzapTitleText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="1" android:text="@string/app_name" />
        <ImageView android:id="@+id/iv_status_ball" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/d_online" android:visibility="gone" android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
