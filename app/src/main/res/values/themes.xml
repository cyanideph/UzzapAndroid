<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Uzzap" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/uzzap_white</item>
        <item name="colorPrimary">@color/uzzap_black</item>
        <item name="colorPrimaryDark">@color/uzzap_black</item>
        <item name="colorAccent">@color/uzzap_special_blue</item>
        <item name="android:textColor">@color/uzzap_text</item>
    </style>

    <style name="Theme.Uzzap.NoTitle" parent="Theme.Uzzap">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/uzzap_black</item>
        <item name="android:navigationBarColor">@color/uzzap_black</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="UzzapSoftkeyText">
        <item name="android:textColor">@color/uzzap_bar_font</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="UzzapTitleText">
        <item name="android:textColor">@color/uzzap_bar_font</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Uzzap.Popup" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="GridIcon">
        <item name="android:layout_width">57dp</item>
        <item name="android:layout_height">57dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="GridIconSmall">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="UzzapMenuRow">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/uzzap_text</item>
        <item name="android:background">@drawable/bg_menu_row_selector</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
</resources>
