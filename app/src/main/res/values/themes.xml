<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Uzzap" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/uzzap_white</item>
        <item name="colorPrimary">@color/uzzap_black</item>
        <item name="colorPrimaryDark">@color/uzzap_black</item>
        <item name="colorAccent">@color/uzzap_special_blue</item>
        <item name="android:textColor">@color/uzzap_text</item>
    </style>

    <style name="Theme.Uzzap.NoTitle" parent="Theme.Uzzap">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/uzzap_black</item>
        <item name="android:navigationBarColor">@color/uzzap_black</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="UzzapSoftkeyText">
        <item name="android:textColor">@color/uzzap_bar_font</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="UzzapTitleText">
        <item name="android:textColor">@color/uzzap_bar_font</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Uzzap.Popup" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="GridIcon">
        <item name="android:layout_width">57dp</item>
        <item name="android:layout_height">57dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="GridIconSmall">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="UzzapMenuRow">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/uzzap_text</item>
        <item name="android:background">@drawable/bg_menu_row_selector</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <!-- ============ REAL RUNTIME THEMES (see ThemeManager) ============ -->
    <style name="UzzapTheme.Classic" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="uzzapColorBg">#FFFFFF</item>
        <item name="uzzapColorSurface">#FFFFFF</item>
        <item name="uzzapColorAccent">#8EEF04</item>
        <item name="uzzapColorText">#191919</item>
        <item name="uzzapColorMuted">#5F5F5F</item>
        <item name="uzzapColorHeader">#0D0CAF</item>
        <item name="uzzapColorDivider">#C8C8C8</item>
        <item name="android:windowBackground">@color/uzzap_white</item>
        <item name="colorAccent">#8EEF04</item>
    </style>
    <style name="UzzapTheme.Dark" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="uzzapColorBg">#101510</item>
        <item name="uzzapColorSurface">#182114</item>
        <item name="uzzapColorAccent">#8EEF04</item>
        <item name="uzzapColorText">#E8F5E8</item>
        <item name="uzzapColorMuted">#9DB89D</item>
        <item name="uzzapColorHeader">#9FC4FF</item>
        <item name="uzzapColorDivider">#26351F</item>
        <item name="android:windowBackground">#101510</item>
    </style>
    <style name="UzzapTheme.Black" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="uzzapColorBg">#000000</item>
        <item name="uzzapColorSurface">#0D0D0D</item>
        <item name="uzzapColorAccent">#8EEF04</item>
        <item name="uzzapColorText">#F5F5F5</item>
        <item name="uzzapColorMuted">#8A8A8A</item>
        <item name="uzzapColorHeader">#C9D8FF</item>
        <item name="uzzapColorDivider">#2A2A2A</item>
        <item name="android:windowBackground">@color/uzzap_black</item>
        <item name="colorAccent">#8EEF04</item>
    </style>
    <style name="UzzapTheme.Blue" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="uzzapColorBg">#0C1524</item>
        <item name="uzzapColorSurface">#12203A</item>
        <item name="uzzapColorAccent">#6FB3FF</item>
        <item name="uzzapColorText">#E8F0FF</item>
        <item name="uzzapColorMuted">#8FA8CC</item>
        <item name="uzzapColorHeader">#9FC4FF</item>
        <item name="uzzapColorDivider">#22385C</item>
        <item name="android:windowBackground">#0C1524</item>
    </style>
    <style name="UzzapTheme.Green" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="uzzapColorBg">#0C1206</item>
        <item name="uzzapColorSurface">#131C0A</item>
        <item name="uzzapColorAccent">#B9FF5E</item>
        <item name="uzzapColorText">#EDF7DF</item>
        <item name="uzzapColorMuted">#9DB88A</item>
        <item name="uzzapColorHeader">#C6E59A</item>
        <item name="uzzapColorDivider">#2A3A18</item>
        <item name="android:windowBackground">#0C1206</item>
    </style>
</resources>
